# Code Studio Docker settings (copy to .env). Keep .env private (chmod 600).

# Host folder with your projects (mounted at /projects) and the app's own data.
CODE_STUDIO_PROJECTS=/mnt/user/coding
CODE_STUDIO_APPDATA=/mnt/user/appdata/code-studio-ide

# Published port and the addresses you browse to (comma separated).
CODE_STUDIO_PORT=8197
CODE_STUDIO_ALLOWED_HOSTS=192.168.1.12,localhost
CODE_STUDIO_CSRF_TRUSTED_ORIGINS=http://192.168.1.12:8197
# 0 for plain-HTTP LAN access; 1 if you put it behind an HTTPS reverse proxy.
CODE_STUDIO_SECURE_COOKIES=0

# File ownership for edits (Unraid default nobody:users = 99:100).
PUID=99
PGID=100
TZ=America/Los_Angeles

# First start only: admin account and the allowlisted root for /projects.
CODE_STUDIO_ADMIN_USER=admin
CODE_STUDIO_ADMIN_PASSWORD=change-me
CODE_STUDIO_ROOT_ALIAS=coding

# Shared IDE<->engine service secret: generate with `openssl rand -hex 32`.
CODE_STUDIO_ENGINE_TOKEN=

# Antigravity is turned on/off in the IDE (Settings > Agent team, admins), not here.
